# .gitignore — intentionally minimal.
# Add per-machine or per-tool exclusions here as needed.
# Project source: legacy/ (v1: dbmapper.html, app.js, style.css, dbviewer.*,
#                 example.sql, tests/), docs/analysis/, AGENTS.md, openspec/,
#                 dbmapper-novo-banco*.json, novo-layout.png

# Per-machine AI tooling (skills/commands live next to the repo
# but are not part of the shipped source).
.claude/
.codex/
.gemini/
.opencode/

# Local screenshots dropped in for ad-hoc visual reference.
modal*.png

# v2 toolchain: dependencies, build output, Bun cache and local SQLite databases.
node_modules/
dist/
.bun/
*.db
*.db-shm
*.db-wal

# Local environment secrets (copy from .env.example).
.env
.env.*
!.env.example
