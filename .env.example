# Copie para .env e ajuste localmente. Nunca faça commit de .env.
# Segredo usado para assinar o JWT de sessão (HS256). Obrigatório quando
# NODE_ENV=production; em desenvolvimento há um fallback que emite aviso.
JWT_SECRET=

# Credenciais do admin inicial criado por `bun run db:seed`.
# Sem DBMAPPER_ADMIN_PASSWORD o seed gera uma senha aleatória e imprime uma vez.
DBMAPPER_ADMIN_EMAIL=admin@example.com
DBMAPPER_ADMIN_PASSWORD=

# Caminho do SQLite (padrão ./dev.db). Arquivos *.db são ignorados pelo git.
DATABASE_URL=./dev.db

# Agente de sugestões (Fase 4) — provider de LLM.
# DBMAPPER_LLM_PROVIDER aceita openai, openrouter ou fake.
# `fake` é somente para testes/e2e: gera sugestões determinísticas sem rede.
DBMAPPER_LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
