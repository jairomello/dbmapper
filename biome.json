{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      "!**/coverage",
      "!**/.git",
      "!**/.bun",
      "!**/.opencode",
      "!**/.claude",
      "!**/.codex",
      "!**/.gemini",
      "!**/.agents",
      "!legacy",
      "!openspec",
      "!docs",
      "!README.md",
      "!AGENTS.md",
      "!CONTRIBUTING.md",
      "!SECURITY.md",
      "!THIRD_PARTY_NOTICES",
      "!LICENSE",
      "!**/db/migrations/meta",
      "!**/*.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off",
        "useConst": "off"
      }
    }
  }
}
